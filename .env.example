# Copy to .env and fill in values. .env is git-ignored.
# App connection used by the ML pipeline / db scripts:
PHARMA_DB_URL=mysql+pymysql://pharma_user:pharma_pass@127.0.0.1:3306/pharma_sc?charset=utf8mb4
# Root password only needed once to run db/setup_db.sh (leave blank afterwards):
MYSQL_ROOT_PWD=
